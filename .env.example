# =============================================================================
# .env.example — variáveis de ambiente do Portal da Rede de Prestadores
# Copie para .env e preencha. NUNCA comite o .env (está no .gitignore).
# Cada variável abaixo é lida pelo código (server.ts / db / auth / scripts).
# =============================================================================

# -----------------------------------------------------------------------------
# APLICAÇÃO / EXECUÇÃO
# -----------------------------------------------------------------------------
# NODE_ENV: "development" (padrão) ou "production".
# Em production: cookies de sessão com flag Secure, mailer exige RESEND_API_KEY,
# e ALLOWED_ORIGINS passa a ser obrigatório.
NODE_ENV="development"

# PORT: porta do servidor Express (padrão 3000). Na Railway é injetada.
PORT="3000"

# APP_URL: URL pública do portal. Usada em links de e-mail (convite, OTP, reset).
APP_URL="http://localhost:3000"

# ALLOWED_ORIGINS: origens permitidas no CORS, separadas por vírgula.
# Dev (padrão se ausente): http://localhost:5173,http://localhost:3000
# OBRIGATÓRIO em produção — o boot aborta se NODE_ENV=production e esta faltar.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# -----------------------------------------------------------------------------
# BANCO DE DADOS — três ambientes num único .env
# -----------------------------------------------------------------------------
# APP_ENV escolhe qual banco usar ao rodar LOCALMENTE (dev | homolog | prod).
# O db.ts resolve DATABASE_URL_<APP_ENV> (ex.: APP_ENV=dev -> DATABASE_URL_DEV).
# Troque de ambiente mudando só APP_ENV.
APP_ENV="dev"

DATABASE_URL_DEV="postgresql://user:password@host:port/database"
DATABASE_URL_HOMOLOG="postgresql://user:password@host:port/database"
DATABASE_URL_PROD="postgresql://user:password@host:port/database"

# ATENÇÃO ao "tiro no pé": com APP_ENV=dev, preencha DATABASE_URL_DEV. Se ficar
# vazia, o db.ts cai para DATABASE_URL (fallback) — então, LOCALMENTE, NÃO defina
# uma DATABASE_URL "pura" apontando para produção. Use só as _DEV/_HOMOLOG/_PROD.
#
# DATABASE_URL (sem sufixo): existe apenas como fallback para a Railway, que a
# injeta automaticamente no serviço de produção. Não defina localmente.
# DATABASE_URL="postgresql://user:password@host:port/database"

# PGSSL: "disable" desliga TLS (ex.: Postgres local sem SSL). Padrão: SSL ligado.
# PGSSL="disable"

# PG_POOL_MAX: máximo de conexões no pool (padrão 10).
# PG_POOL_MAX="10"

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO / SEGURANÇA
# -----------------------------------------------------------------------------
# JWT_SECRET: segredo de assinatura dos tokens de sessão. OBRIGATÓRIO — o boot
# do servidor aborta sem ele. Gere um valor aleatório forte:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-forte"

# IP_HASH_SECRET: sal para o HMAC dos IPs nos access_logs (LGPD), mínimo 32 chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# Sessão: expira após SESSION_IDLE_MINUTES sem uso (cada request renova) e, no
# máximo, SESSION_MAX_HOURS após o login. Logout, definição/troca de senha e
# desativação encerram todas as sessões do usuário (users.session_version).
SESSION_IDLE_MINUTES="30"
SESSION_MAX_HOURS="8"

# -----------------------------------------------------------------------------
# E-MAIL — código OTP (2FA) e convites, via Resend
# -----------------------------------------------------------------------------
# OBRIGATÓRIO em produção: o boot aborta se faltar com NODE_ENV=production.
# Em dev, sem essas variáveis, o ConsoleMailer apenas imprime o código no log.
# Verifique o domínio no Resend (SPF/DKIM) antes do go-live.
RESEND_API_KEY=""
MAIL_FROM="Portal Unimed <nao-responda@seu-dominio-verificado.com>"

# Fase de testes: com EMAIL_ALLOWLIST definida, SÓ destinatários cujo endereço
# TERMINA com alguma entrada recebem e-mail real (separar por vírgula).
# "homolog@hotmail.com" pega adm-homolog@/prestador-homolog@/...; "@dominio.com"
# libera o domínio todo; um e-mail completo libera só ele. Resto: suprimido+logado.
# No homolog a lista é OBRIGATÓRIA para sair do ConsoleMailer. Em produção, deixe vazia.
# Ex.: EMAIL_ALLOWLIST="homolog@hotmail.com,@sigmma.health"
EMAIL_ALLOWLIST=""

# -----------------------------------------------------------------------------
# LGPD — retenção de logs e Encarregado de Dados (DPO)
# -----------------------------------------------------------------------------
# RETENTION_AUTO_PURGE=false desabilita o expurgo oportunista de logs no boot.
RETENTION_AUTO_PURGE=true

# DPO_NAME / DPO_EMAIL: exibidos em /politica-privacidade.
DPO_NAME=
DPO_EMAIL=

# -----------------------------------------------------------------------------
# SCRIPTS DE CARGA (CLI) — opcionais, só ao rodar os importadores
# -----------------------------------------------------------------------------
# ROTEIROS_DIR: pasta dos .xlsx dos roteiros (padrão: ../rota-qualificacao).
# ROTEIROS_DIR="../rota-qualificacao"

# CADASTRO_FILE: planilha de prestadores lida por db/import-providers.ts
# (padrão: ../cadastro_prestadores_v0.xlsx). Aponte para o arquivo corrigido
# (ex.: ../cadastro_prestadores_v1.xlsx) quando aplicável.
# CADASTRO_FILE="../cadastro_prestadores_v1.xlsx"

# CADASTRO_SHEET: aba lida na planilha de cadastro (padrão: "Match").
# CADASTRO_SHEET="Match"

# -----------------------------------------------------------------------------
# BUILD / DEV (Vite)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY: resíduo do template do AI Studio (injetado no bundle pelo
# vite.config.ts). NÃO é usado pelo app — pode ser removido com segurança.
# GEMINI_API_KEY=""

# DISABLE_HMR="true" desliga o hot-reload do Vite (usado no ambiente AI Studio).
# DISABLE_HMR="true"
